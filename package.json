{
  "name": "gagebu",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.5.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test src/lib/*.test.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:firestore": "firebase emulators:exec --config firebase.test.json --project demo-gagebu --only firestore \"node --import tsx --test tests/firestore.test.ts\"",
    "test:e2e": "playwright test",
    "test:ios": "playwright test -c playwright.ios.config.ts"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "next": "16.3.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "firebase-tools": "^15.30.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
